# EASIEST OPTION: Discord server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# ALTERNATIVE: actual Discord application/bot token and a numeric channel ID
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=

POLL_SECONDS=900
DATABASE_PATH=seen_jobs.sqlite3
# skip_existing (recommended) or notify_existing (may produce many notifications)
BOOTSTRAP_MODE=skip_existing
